<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- T1-6: nullable anotacije su ugovor za Swagger i frontend tipove (FE-ADR-0004). CS8618: DTO-ovi su podatkovni ugovori koje
             puni System.Text.Json; ne-nullable svojstvo bez inicijalizatora je namjerno (ponašanje se ne mijenja). -->
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS8618;CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    </ItemGroup>

</Project>
